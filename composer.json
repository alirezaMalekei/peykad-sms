{
    "name": "alireza_malekei/peykad-sms",
    "description": "Peykad SMS: a driver-based SMS sending package for Laravel with support for bulk and scheduled messages",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "peykad",
        "laravel",
        "sms",
        "sms-gateway",
        "iran",
        "driver"
    ],
    "authors": [
        {
            "name": "Alireza Malekei",
            "email": "alirezaMalekei72@gmail.com",
            "homepage": "https://github.com/alirezaMalekei",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "AlirezaMalekei\\PeykadSms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlirezaMalekei\\PeykadSms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlirezaMalekei\\PeykadSms\\SmsServiceProvider"
            ],
            "aliases": {
                "Sms": "AlirezaMalekei\\PeykadSms\\Facades\\Sms"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
